# Copy this file to `.env` on the server and fill it in:   cp .env.example .env && nano .env
# Never share or commit the real .env (it holds your admin key).

# ---- Your site -------------------------------------------------------------
SITE_DOMAIN=toolzbaba.com
SITE_URL=https://toolzbaba.com
SITE_NAME=Toolz Baba
# SITE_TAGLINE=Free online image, PDF, video and file tools
CONTACT_EMAIL=hello@toolzbaba.com

# ---- Secrets ---------------------------------------------------------------
# Generate with:  openssl rand -hex 32
# Lets YOU delete any hosted image:  curl -X DELETE -H "X-Admin-Key: <this>" https://toolzbaba.com/api/cdn/<image-id>
ADMIN_KEY=paste-a-random-string-here

# ---- Fair use --------------------------------------------------------------
RATE_LIMIT=on
# Per visitor per hour, on top of the built-in defaults. Format: name=count/seconds
# names: tool_light tool_heavy cdn_upload admin
# RATE_LIMITS=tool_heavy=20/3600,cdn_upload=30/3600
MAX_ACTIVE_PER_IP=3
# Heavy jobs (video, AI) processed at the same time. 2 is right for 4 GB RAM, 3-4 for 8 GB.
MAX_CONCURRENT_JOBS=3
# Cloudflare's free plan rejects uploads over 100 MB. Keep this as is if you use the orange cloud.
MAX_UPLOAD_MB=2100

# ---- Image hosting (Image to CDN Link) -------------------------------------
CDN_RETENTION_DAYS=90
CDN_MAX_TOTAL_MB=20000
CDN_MAX_FILE_MB=25

# TRUSTED_PROXY, DATA_DIR and the image-link base address (from SITE_URL) are set for you by docker-compose.prod.yml

# ---- Optional --------------------------------------------------------------
# Path to soffice if LibreOffice is not found automatically (already fine in Docker)
# LIBREOFFICE_PATH=/usr/bin/soffice
# Raw HTML added to every page <head> (analytics, Search Console / AdSense verification tags)
# HEAD_EXTRA=<meta name="google-site-verification" content="xxxx">
