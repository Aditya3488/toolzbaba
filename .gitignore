# ---- Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ---- Local runtime data: AI models (hundreds of MB), hosted images, secret key, logs
data/
backups/
*.log

node_modules/

# ---- Secrets: never commit these
.env
.env.*
!.env.example

# ---- Test artifacts (generated on demand)
tests/samples/
tests/out/

# ---- OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---- Static site build output (python build.py)
dist/
.wrangler/

# ---- Cloudflare local dev: secrets and state
.dev.vars
.wrangler/

# ---- India SaaS pipeline
# the blanket "data/" rule above would hide the generated database too, so let that
# one folder back in; only its HTTP cache stays out (it is rebuilt on demand)
!india_saas/data/
india_saas/data/cache/
